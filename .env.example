# Get a key at https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Optional. Get a key at https://exa.ai — used as a fallback to extract
# postings from pages Firecrawl can't scrape (e.g. LinkedIn, Reddit).
EXA_API_KEY=your_exa_api_key

# Which command-line AI tool runs the prompts. Leave both unset for Claude Code.
# {prompt} is replaced with the full prompt text; everything else is passed
# through as written.
#   LLM_CLI=codex
#   LLM_ARGS=exec {prompt}
